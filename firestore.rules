rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // This security rules file assumes the following data structures:
    //
    // Collection: news
    // Document ID: auto-generated or string slug
    // Fields:
    //   - title: string
    //   - date: string (YYYY-MM-DD)
    //   - summary / description: string
    //   - content: string
    //   - category: string
    //   - coverImage / image: string (optional)
    //
    // Collection: projects
    // Document ID: auto-generated or string ID
    // Fields:
    //   - title: string
    //   - description: string
    //   - category / type: string
    //   - status: string
    //   - createdAt: timestamp
    //
    // Collection: members
    // Document ID: auto-generated or string ID
    // Fields:
    //   - name / institution: string
    //   - tier / category: string
    //   - logo / icon: string (optional)
    //   - createdAt: timestamp
    //
    // Collection: siteConfig
    // Document ID: 'committee' | 'organisation' | 'contact' | 'international' | 'disclosure'
    // Fields: key-value configuration objects
    //
    // Collection: notices (legacy compatibility)
    // Document ID: auto-generated
    //
    // Collection: achievements (legacy compatibility)
    // Document ID: auto-generated
    //
    // Collection: enquiries
    // Document ID: auto-generated
    // Fields:
    //   - institution: string
    //   - countryRegionCode: string
    //   - contactName: string
    //   - position: string (optional)
    //   - email: string
    //   - cooperationCategoryCode: string
    //   - requirementSummary: string (<= 4000 chars)
    //   - privacyConsent: bool
    //   - sourcePage: string
    //   - status: string ('pending' | 'reviewing' | 'contacted' | 'archived')
    //   - createdAt: timestamp
    //
    // Collection: inquiries (legacy compatibility alias)
    // Fields: contact, content, desc, message, name, unit, type, field, source, date, status, createdAt
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    // Dedicated English website project (cauiice-site-en) Administrator check.
    // Strictly restricts administrative mutations and enquiries management
    // exclusively to the verified Admin UID.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'clQUlsYgbRU9DCmK08xOOXlU7lo2';
    }

    // ===============================================================
    // 1. Official Public Portal Content Collections
    // Public read-only; mutations restricted strictly to administrators.
    // ===============================================================

    // News & Media Center
    match /news/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // International Cooperation Projects
    match /projects/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Member Institutions Directory
    match /members/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global Site Configuration (committee, organisation, contact, etc.)
    match /siteConfig/{configDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notices & Announcements (legacy compatibility)
    match /notices/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Achievements & Think Tank (legacy compatibility)
    match /achievements/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // 2. Enquiries & Feedback Collections
    // Public can create with strict validation; reads/updates/deletes are admin-only.
    // ===============================================================

    // English Portal Partnership Enquiries
    match /enquiries/{enquiryId} {
      // Management restricted to authenticated administrators
      allow read, update, delete: if isAdmin();

      // Public visitor submission: create only, strict whitelist and length bounds
      allow create: if request.resource.data.keys().hasOnly([
          'institution', 'countryRegionCode', 'contactName', 'position',
          'email', 'cooperationCategoryCode', 'requirementSummary',
          'privacyConsent', 'sourcePage', 'status', 'createdAt',
          'contact', 'content', 'desc', 'message',
          'name', 'unit', 'type', 'field', 'source', 'date'
        ])
        && request.resource.data.email is string
        && request.resource.data.requirementSummary is string
        && request.resource.data.requirementSummary.size() <= 4000;
    }

    // Public Inquiries & Consultation (legacy compatibility alias)
    match /inquiries/{inquiryId} {
      // Management restricted to authenticated administrators
      allow read, update, delete: if isAdmin();

      // Public visitor submission: create only, supports English and legacy schemas
      allow create: if request.resource.data.keys().hasOnly([
          'institution', 'countryRegionCode', 'contactName', 'position',
          'email', 'cooperationCategoryCode', 'requirementSummary',
          'privacyConsent', 'sourcePage', 'status', 'createdAt',
          'contact', 'content', 'desc', 'message',
          'name', 'unit', 'type', 'field', 'source', 'date'
        ])
        && (
          // English enquiry format
          (('email' in request.resource.data)
            && request.resource.data.email is string
            && ('requirementSummary' in request.resource.data)
            && request.resource.data.requirementSummary is string
            && request.resource.data.requirementSummary.size() <= 4000)
          ||
          // Legacy inquiry format
          (('contact' in request.resource.data)
            && request.resource.data.contact is string
            && (
              (('content' in request.resource.data) && request.resource.data.content is string && request.resource.data.content.size() <= 4000) ||
              (('desc' in request.resource.data) && request.resource.data.desc is string && request.resource.data.desc.size() <= 4000) ||
              (('message' in request.resource.data) && request.resource.data.message is string && request.resource.data.message.size() <= 4000) ||
              (('requirementSummary' in request.resource.data) && request.resource.data.requirementSummary is string && request.resource.data.requirementSummary.size() <= 4000)
            ))
        );
    }

    // ===============================================================
    // 3. Default Deny Rule
    // Deny all unhandled paths and operations across the entire database.
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
